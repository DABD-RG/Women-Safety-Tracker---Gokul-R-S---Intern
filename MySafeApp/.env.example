# ==========================================
# Women Safety Tracker - Environment Setup
# ==========================================

# ------------------------------------------
# TWILIO CREDENTIALS (BACKEND)
# ------------------------------------------
# Get these from your Twilio Console (https://console.twilio.com)
# WARNING: NEVER commit your real credentials to GitHub.
TWILIO_ACCOUNT_SID=your_twilio_account_sid_here
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here

# The Twilio phone number you send FROM (must be a number you own/verified in Twilio)
# Format as E.164 (e.g., +12345678900)
TWILIO_FROM_NUMBER=+1xxxxxxxxxx

# Optional fallback recipient if an SOS request doesn't include contacts
EMERGENCY_TO_NUMBER=

# ------------------------------------------
# SERVER CONFIGURATION
# ------------------------------------------
PORT=5000

# ------------------------------------------
# FRONTEND CONFIGURATION (VITE)
# ------------------------------------------
# Leave VITE_API_URL blank for local development (Vite proxies /api automatically).
# For production builds, set this to your deployed backend URL, e.g.:
# VITE_API_URL=https://mysafeapp-server.onrender.com
VITE_API_URL=
