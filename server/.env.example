# Get these from https://console.twilio.com
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token_here

# The Twilio phone number you send FROM (must be a number you own/verified in Twilio)
TWILIO_FROM_NUMBER=+1xxxxxxxxxx

# Optional fallback recipient if a request doesn't include contacts
EMERGENCY_TO_NUMBER=

PORT=5000
